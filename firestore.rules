rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function currentUserDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

        function hasValidMessageFields(message) {
      return message.keys().hasAll([
            'text',
            'senderId',
            'senderEmail',
            'senderName',
            'createdAt'
          ])
          && message.keys().hasOnly([
            'messageType',
            'text',
            'image',
            'senderId',
            'senderEmail',
            'senderName',
            'createdAt'
          ]);
    }

    function hasValidTextValue(text) {
      return text is string
          && text == text.trim()
          && text.size() > 0
          && text.size() <= 4096;
    }

    function isLegacyTextMessage(message) {
      return !message.keys().hasAny([
            'messageType',
            'image'
          ])
          && hasValidTextValue(message.text);
    }

    function isExplicitTextMessage(message) {
      return message.get('messageType', '') == 'text'
          && !message.keys().hasAny(['image'])
          && hasValidTextValue(message.text);
    }

    function isValidImageMessage(chatId, messageId, message) {
      let image = message.get('image', {});
      let version = image.get('version', 0);

      return message.get('messageType', '') == 'image'
          && message.text is string
          && message.text == ''

          && image is map
          && image.keys().hasAll([
            'provider',
            'thumbStoragePath',
            'fullStoragePath',
            'thumbSizeBytes',
            'fullSizeBytes',
            'thumbWidth',
            'thumbHeight',
            'fullWidth',
            'fullHeight',
            'mimeType',
            'version'
          ])
          && image.keys().hasOnly([
            'provider',
            'thumbStoragePath',
            'fullStoragePath',
            'thumbSizeBytes',
            'fullSizeBytes',
            'thumbWidth',
            'thumbHeight',
            'fullWidth',
            'fullHeight',
            'mimeType',
            'version'
          ])

          && image.provider is string
          && image.provider == 'firebase'

          && version is int
          && version > 0

          && image.thumbStoragePath is string
          && image.thumbStoragePath
              == 'chat_media/' + chatId
                  + '/messages/' + messageId
                  + '/v' + string(version)
                  + '/thumb.jpg'

          && image.fullStoragePath is string
          && image.fullStoragePath
              == 'chat_media/' + chatId
                  + '/messages/' + messageId
                  + '/v' + string(version)
                  + '/full.jpg'

          && image.thumbStoragePath != image.fullStoragePath

          && image.thumbSizeBytes is int
          && image.thumbSizeBytes > 0
          && image.thumbSizeBytes <= 128 * 1024

          && image.fullSizeBytes is int
          && image.fullSizeBytes > 0
          && image.fullSizeBytes <= 1024 * 1024

          && image.thumbWidth is int
          && image.thumbWidth > 0
          && image.thumbWidth <= 480

          && image.thumbHeight is int
          && image.thumbHeight > 0
          && image.thumbHeight <= 480

          && image.fullWidth is int
          && image.fullWidth >= image.thumbWidth
          && image.fullWidth <= 1920

          && image.fullHeight is int
          && image.fullHeight >= image.thumbHeight
          && image.fullHeight <= 1920

          && image.mimeType is string
          && image.mimeType == 'image/jpeg';
    }

    function messagePreview(message) {
      return message.get('messageType', 'text') == 'image'
          ? 'Фотография'
          : message.text;
    }

    function isValidMessageData(chatId, messageId, message) {
      let profile = currentUserDoc().data;

      return signedIn()
          && hasValidMessageFields(message)

          && message.senderId is string
          && message.senderId == request.auth.uid

          && message.senderEmail is string
          && message.senderEmail == request.auth.token.email

          && message.senderName is string
          && message.senderName == profile.get('name', '')

          && message.createdAt is timestamp
          && message.createdAt == request.time

          && (
            isLegacyTextMessage(message)
            || isExplicitTextMessage(message)
            || isValidImageMessage(chatId, messageId, message)
          );
    }

    function isValidNewMessage(chatId, messageId) {
      return isValidMessageData(
        chatId,
        messageId,
        request.resource.data
      );
    }

    function hasValidPrivateChatFields() {
  return request.resource.data.keys().hasAll([
        'name',
        'type',
        'memberIds',
        'memberEmails',
        'memberRoles',
        'memberStatus',
        'groupSettings',
        'lastRead',
        'isDissolved',
        'createdAt',
        'lastMessage',
        'lastMessageAt',
        'lastMessageId',
        'firstMessageId'
      ])
      && request.resource.data.keys().hasOnly([
        'name',
        'type',
        'memberIds',
        'memberEmails',
        'memberRoles',
        'memberStatus',
        'groupSettings',
        'lastRead',
        'isDissolved',
        'createdAt',
        'lastMessage',
        'lastMessageAt',
        'lastMessageId',
        'firstMessageId'
      ]);
}

function isValidPrivateChatCreate(chatId) {
  let chat = request.resource.data;
  let firstId = chat.memberIds[0];
  let secondId = chat.memberIds[1];
  let firstMessageId = chat.firstMessageId;
  let firstMessage = getAfter(
    /databases/$(database)/documents/chats/$(chatId)/messages/$(firstMessageId)
  ).data;

  return hasValidPrivateChatFields()
      && chat.name == 'private_chat'
      && chat.type == 'private'

      && chat.memberIds is list
      && chat.memberIds.size() == 2
      && chat.memberIds.toSet().size() == 2
      && request.auth.uid in chat.memberIds

      && (
        chatId == firstId + '_' + secondId
        || chatId == secondId + '_' + firstId
      )

      && exists(
        /databases/$(database)/documents/users/$(firstId)
      )
      && exists(
        /databases/$(database)/documents/users/$(secondId)
      )

      && chat.memberEmails is list
      && chat.memberEmails.size() > 0
      && chat.memberEmails.size() <= 2
      && request.auth.token.email in chat.memberEmails

      && chat.memberRoles is map
      && chat.memberRoles.keys().hasAll(chat.memberIds)
      && chat.memberRoles.keys().hasOnly(chat.memberIds)
      && chat.memberRoles[firstId] == 'member'
      && chat.memberRoles[secondId] == 'member'

      && chat.memberStatus is map
      && chat.memberStatus.keys().hasAll(chat.memberIds)
      && chat.memberStatus.keys().hasOnly(chat.memberIds)
      && chat.memberStatus[firstId] is map
      && chat.memberStatus[secondId] is map
      && chat.memberStatus[firstId].keys().hasAll(['status'])
      && chat.memberStatus[firstId].keys().hasOnly(['status'])
      && chat.memberStatus[secondId].keys().hasAll(['status'])
      && chat.memberStatus[secondId].keys().hasOnly(['status'])
      && chat.memberStatus[firstId].status == 'normal'
      && chat.memberStatus[secondId].status == 'normal'

      && chat.groupSettings is map
      && chat.groupSettings.keys().hasAll(['messagePermission'])
      && chat.groupSettings.keys().hasOnly(['messagePermission'])
      && chat.groupSettings.messagePermission == 'all'

      && chat.lastRead is map
      && chat.lastRead.keys().hasAll([request.auth.uid])
      && chat.lastRead.keys().hasOnly([request.auth.uid])
      && chat.lastRead[request.auth.uid] is timestamp
      && chat.lastRead[request.auth.uid] == request.time

      && chat.isDissolved == false

      && chat.createdAt is timestamp
      && chat.createdAt == request.time

      && chat.lastMessage is string
      && chat.lastMessage == chat.lastMessage.trim()
      && chat.lastMessage.size() > 0
      && chat.lastMessage.size() <= 4096

      && chat.lastMessageAt is timestamp
      && chat.lastMessageAt == request.time

      && chat.lastMessageId is string
      && chat.lastMessageId.size() > 0

      && chat.firstMessageId is string
      && chat.firstMessageId.size() > 0
      && chat.lastMessageId == chat.firstMessageId

      // Полное содержимое первого сообщения проверяется отдельно
      // в allow create вложенного документа messages/{messageId}.
      && messagePreview(firstMessage) == chat.lastMessage
      && firstMessage.createdAt is timestamp
      && firstMessage.createdAt == chat.lastMessageAt;
}

function isValidChatCreate(chatId) {
  let chatType = request.resource.data.get('type', '');

  return signedIn()
      && (
        (
          chatType == 'private'
          && isValidPrivateChatCreate(chatId)
        )
        || chatType == 'group'
      );
}
function isFirstMessageForNewPrivateChat(chatId, messageId) {
  let chatAfter = getAfter(
    /databases/$(database)/documents/chats/$(chatId)
  ).data;

  return signedIn()
      && !exists(
        /databases/$(database)/documents/chats/$(chatId)
      )
      && chatAfter.type == 'private'
      && chatAfter.firstMessageId == messageId
      && chatAfter.lastMessageId == messageId
      && chatAfter.memberIds is list
      && chatAfter.memberIds.size() == 2
      && request.auth.uid in chatAfter.memberIds
            && chatAfter.lastMessage
          == messagePreview(request.resource.data)
      && chatAfter.lastMessageAt == request.time
      && chatAfter.createdAt == request.time;
}

function isMessageLinkedToExistingChatUpdate(chatId, messageId) {
  let chatAfter = getAfter(
    /databases/$(database)/documents/chats/$(chatId)
  ).data;

  return chatAfter.lastMessageId == messageId
            && chatAfter.lastMessage
          == messagePreview(request.resource.data)
      && chatAfter.lastMessageAt == request.time;
}

    function isChatMember(chatId) {
      return signedIn()
          && request.auth.uid in chatDoc(chatId).data.memberIds;
    }

    function getRole(chatId) {
      return chatDoc(chatId).data.memberRoles[request.auth.uid];
    }

    function getStatus(chatId) {
      return chatDoc(chatId).data.memberStatus[request.auth.uid].status;
    }

    function getStatusData(chatId) {
      return chatDoc(chatId).data.memberStatus[request.auth.uid];
    }

    function isStatusActive(chatId) {
      return getStatusData(chatId).permanent == true
          || (
            getStatusData(chatId).expiresAt is timestamp
            && getStatusData(chatId).expiresAt > request.time
          );
    }

    function isActivelyMutedOrBanned(chatId) {
      return (
            getStatus(chatId) == 'muted'
            || getStatus(chatId) == 'banned'
          )
          && isStatusActive(chatId);
    }

    function getMessagePermission(chatId) {
      return chatDoc(chatId).data.groupSettings.messagePermission;
    }

    function isAdminOrOwner(chatId) {
      return getRole(chatId) == 'admin'
          || getRole(chatId) == 'owner';
    }

    function isModeratorOrAbove(chatId) {
      return getRole(chatId) == 'moderator'
          || getRole(chatId) == 'admin'
          || getRole(chatId) == 'owner';
    }

    function isPrivateChat(chatId) {
      return chatDoc(chatId).data.type == 'private';
    }

    function canWrite(chatId) {
      return isChatMember(chatId)
          && (
            isPrivateChat(chatId)
            ||
            (
              getRole(chatId) != 'guest'
              && !isActivelyMutedOrBanned(chatId)
              && (
                getMessagePermission(chatId) == 'all'
                ||
                (
                  getMessagePermission(chatId) == 'moderators'
                  && isModeratorOrAbove(chatId)
                )
                ||
                (
                  getMessagePermission(chatId) == 'admins'
                  && isAdminOrOwner(chatId)
                )
              )
            )
          );
    }

    function currentRoleInChat() {
      return resource.data.memberRoles[request.auth.uid];
    }

    function isCurrentMemberInChat() {
      return signedIn()
          && request.auth.uid in resource.data.memberIds;
    }

    function isCurrentAdminOrOwner() {
      return currentRoleInChat() == 'admin'
          || currentRoleInChat() == 'owner';
    }

    function isCurrentModeratorOrAbove() {
      return currentRoleInChat() == 'moderator'
          || currentRoleInChat() == 'admin'
          || currentRoleInChat() == 'owner';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function avatarMetadataKeys() {
      return [
        'avatarProvider',
        'avatarThumbStoragePath',
        'avatarFullStoragePath',
        'avatarThumbSizeBytes',
        'avatarFullSizeBytes',
        'avatarVersion',
        'avatarUpdatedAt'
      ];
    }

    function avatarControlledKeys() {
      return [
        'avatarProvider',
        'avatarThumbStoragePath',
        'avatarFullStoragePath',
        'avatarThumbSizeBytes',
        'avatarFullSizeBytes',
        'avatarVersion',
        'avatarUpdatedAt',
        'avatarUrl',
        'avatarThumbUrl',
        'avatarFullUrl'
      ];
    }
    function groupAvatarMetadataKeys() {
  return [
    'groupAvatarProvider',
    'groupAvatarThumbStoragePath',
    'groupAvatarFullStoragePath',
    'groupAvatarThumbSizeBytes',
    'groupAvatarFullSizeBytes',
    'groupAvatarVersion',
    'groupAvatarUpdatedAt'
  ];
}

function groupAvatarControlledKeys() {
  return [
    'groupAvatarProvider',
    'groupAvatarThumbStoragePath',
    'groupAvatarFullStoragePath',
    'groupAvatarThumbSizeBytes',
    'groupAvatarFullSizeBytes',
    'groupAvatarVersion',
    'groupAvatarUpdatedAt',
    'groupAvatarUrl',
    'groupAvatarThumbUrl',
    'groupAvatarFullUrl',
    'avatarUrl',
    'avatarThumbUrl',
    'avatarFullUrl'
  ];
}

function hasValidGroupAvatarMetadata(chatId) {
  let chat = request.resource.data;
  let version = chat.groupAvatarVersion;

  return chat.keys().hasAll(groupAvatarMetadataKeys())
      && chat.groupAvatarProvider is string
      && chat.groupAvatarProvider == 'firebase'

      && chat.groupAvatarThumbStoragePath is string
      && chat.groupAvatarThumbStoragePath
          == 'group_avatars/' + chatId + '/v' + string(version)
              + '/thumb.jpg'

      && chat.groupAvatarFullStoragePath is string
      && chat.groupAvatarFullStoragePath
          == 'group_avatars/' + chatId + '/v' + string(version)
              + '/full.jpg'

      && chat.groupAvatarThumbSizeBytes is int
      && chat.groupAvatarThumbSizeBytes >= 0
      && chat.groupAvatarThumbSizeBytes <= 128 * 1024

      && chat.groupAvatarFullSizeBytes is int
      && chat.groupAvatarFullSizeBytes >= 0
      && chat.groupAvatarFullSizeBytes <= 512 * 1024

      && version is int
      && version > 0

      && chat.groupAvatarUpdatedAt is timestamp;
}

function isGroupAvatarMetadataUpdate(chatId) {
  return signedIn()
      && resource.data.type == 'group'
      && request.resource.data.type == 'group'

      && isCurrentMemberInChat()
      && isCurrentAdminOrOwner()

      && changedKeys().hasOnly(groupAvatarMetadataKeys())
      && changedKeys().hasAny(['groupAvatarVersion'])

      && hasValidGroupAvatarMetadata(chatId)

      && (
        !resource.data.keys().hasAny(['groupAvatarVersion'])
        || (
          resource.data.groupAvatarVersion is int
          && request.resource.data.groupAvatarVersion
              > resource.data.groupAvatarVersion
        )
      );
}

    function hasValidAvatarMetadata(userId) {
      let user = request.resource.data;
      let version = user.avatarVersion;

      return user.keys().hasAll(avatarMetadataKeys())
          && user.avatarProvider is string
          && user.avatarProvider == 'firebase'
          && user.avatarThumbStoragePath is string
          && user.avatarThumbStoragePath
              == 'user_avatars/' + userId + '/v' + string(version)
                  + '/thumb.jpg'
          && user.avatarFullStoragePath is string
          && user.avatarFullStoragePath
              == 'user_avatars/' + userId + '/v' + string(version)
                  + '/full.jpg'
          && user.avatarThumbSizeBytes is int
          && user.avatarThumbSizeBytes >= 0
          && user.avatarThumbSizeBytes <= 128 * 1024
          && user.avatarFullSizeBytes is int
          && user.avatarFullSizeBytes >= 0
          && user.avatarFullSizeBytes <= 512 * 1024
          && version is int
          && version > 0
          && user.avatarUpdatedAt is timestamp;
    }

    function hasNoNewAvatarUrls() {
      return request.resource.data.get('avatarUrl', '') == ''
          && !request.resource.data.keys()
              .hasAny(['avatarThumbUrl', 'avatarFullUrl']);
    }

    function hasValidAvatarMetadataOnCreate(userId) {
      return hasNoNewAvatarUrls()
          && (
            !request.resource.data.keys().hasAny(avatarMetadataKeys())
            || hasValidAvatarMetadata(userId)
          );
    }

    function hasValidUserUpdate(userId) {
      return !changedKeys().hasAny(avatarControlledKeys())
          || (
            changedKeys().hasOnly(avatarMetadataKeys())
            && changedKeys().hasAny(['avatarVersion'])
            && hasValidAvatarMetadata(userId)
            && (
              !resource.data.keys().hasAny(['avatarVersion'])
              || (
                resource.data.avatarVersion is int
                && request.resource.data.avatarVersion
                    > resource.data.avatarVersion
              )
            )
          );
    }

    function isOwnLastReadUpdate() {
  let oldLastRead =
      resource.data.get('lastRead', {});

  let newLastRead =
      request.resource.data.get('lastRead', {});

  return signedIn()
      && isCurrentMemberInChat()

      && changedKeys().hasOnly([
        'lastRead'
      ])

      && oldLastRead is map
      && newLastRead is map

      && newLastRead.keys().hasAll([
        request.auth.uid
      ])

      && newLastRead
          .diff(oldLastRead)
          .affectedKeys()
          .hasOnly([
            request.auth.uid
          ])

      && newLastRead[request.auth.uid] is timestamp
      && newLastRead[request.auth.uid] == request.time;
}

function isPrivateReadReceiptUpdate(chatId) {
  let oldLastRead =
      resource.data.get('lastRead', {});

  let newLastRead =
      request.resource.data.get('lastRead', {});

  let oldReadState =
      resource.data.get('privateReadState', {});

  let newReadState =
      request.resource.data.get('privateReadState', {});

  let oldCursor =
      oldReadState.get(request.auth.uid, {});

  let newCursor =
      newReadState.get(request.auth.uid, {});

  let messageId =
      newCursor.get('messageId', '');

  return signedIn()

      && resource.data.type == 'private'
      && request.resource.data.type == 'private'

      && isCurrentMemberInChat()

      && request.resource.data.memberIds
          == resource.data.memberIds

      && changedKeys().hasAll([
        'lastRead',
        'privateReadState'
      ])

      && changedKeys().hasOnly([
        'lastRead',
        'privateReadState'
      ])

      && oldLastRead is map
      && newLastRead is map

      && newLastRead.keys().hasAll([
        request.auth.uid
      ])

      && newLastRead
          .diff(oldLastRead)
          .affectedKeys()
          .hasOnly([
            request.auth.uid
          ])

      && newLastRead[request.auth.uid] is timestamp
      && newLastRead[request.auth.uid] == request.time

      && oldReadState is map
      && newReadState is map

      && newReadState.keys().hasAll([
        request.auth.uid
      ])

      && newReadState
          .diff(oldReadState)
          .affectedKeys()
          .hasOnly([
            request.auth.uid
          ])

      && newCursor is map

      && newCursor.keys().hasAll([
        'messageId',
        'messageCreatedAt',
        'readAt'
      ])

      && newCursor.keys().hasOnly([
        'messageId',
        'messageCreatedAt',
        'readAt'
      ])

      && messageId is string
      && messageId.size() > 0
      && !messageId.matches('.*[/].*')

      && newCursor.messageCreatedAt is timestamp

      && newCursor.readAt is timestamp
      && newCursor.readAt == request.time

      && exists(
        /databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)
      )

      && get(
        /databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)
      ).data.createdAt is timestamp

      && get(
        /databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)
      ).data.createdAt
          == newCursor.messageCreatedAt

      && (
        !oldReadState.keys().hasAny([
          request.auth.uid
        ])

        || (
          oldCursor is map

          && oldCursor.messageId is string
          && oldCursor.messageCreatedAt is timestamp

          && (
            newCursor.messageCreatedAt
                > oldCursor.messageCreatedAt

            || (
              newCursor.messageCreatedAt
                  == oldCursor.messageCreatedAt

              && newCursor.messageId
                  == oldCursor.messageId
            )
          )
        )
      );
}
    function isClearPrivateChatForCurrentUserUpdate() {
  let oldClearedAtByUser =
      resource.data.get('clearedAtByUser', {});

  let newClearedAtByUser =
      request.resource.data.get('clearedAtByUser', {});

  return signedIn()
      && resource.data.type == 'private'
      && request.resource.data.type == 'private'

      && request.auth.uid in resource.data.memberIds
      && request.resource.data.memberIds == resource.data.memberIds

      && changedKeys().hasOnly([
        'clearedAtByUser',
        'lastRead'
      ])

      && oldClearedAtByUser is map
      && newClearedAtByUser is map

      && newClearedAtByUser.keys().hasAll([
        request.auth.uid
      ])

      && newClearedAtByUser
          .diff(oldClearedAtByUser)
          .affectedKeys()
          .hasOnly([request.auth.uid])

      && newClearedAtByUser[request.auth.uid] is timestamp
      && newClearedAtByUser[request.auth.uid] == request.time

      && request.resource.data.lastRead is map

      && request.resource.data.lastRead
          .diff(resource.data.lastRead)
          .affectedKeys()
          .hasOnly([request.auth.uid])

      && request.resource.data.lastRead[request.auth.uid] is timestamp
      && request.resource.data.lastRead[request.auth.uid] == request.time;
}
function isOwnNotificationSettingsUpdate() {
  let oldSettings =
      resource.data.get('notificationSettingsByUser', {});

  let newSettings =
      request.resource.data.get('notificationSettingsByUser', {});

  let ownSettings =
      newSettings.get(request.auth.uid, {});

  let mode =
      ownSettings.get('mode', '');

  return signedIn()
      && isCurrentMemberInChat()

      && changedKeys().hasOnly([
        'notificationSettingsByUser'
      ])

      && oldSettings is map
      && newSettings is map

      && newSettings.keys().hasAll([
        request.auth.uid
      ])

      && newSettings
          .diff(oldSettings)
          .affectedKeys()
          .hasOnly([
            request.auth.uid
          ])

      && ownSettings is map

      && (
        (
          mode == 'sound'

          && ownSettings.keys().hasOnly([
            'mode'
          ])
        )

        ||

        (
          mode == 'disabled'

          && ownSettings.keys().hasOnly([
            'mode'
          ])
        )

        ||

        (
          mode == 'silent'

          && (
            (
              ownSettings.keys().hasAll([
                'mode',
                'permanent'
              ])

              && ownSettings.keys().hasOnly([
                'mode',
                'permanent'
              ])

              && ownSettings.permanent == true
            )

            ||

            (
              ownSettings.keys().hasAll([
                'mode',
                'expiresAt'
              ])

              && ownSettings.keys().hasOnly([
                'mode',
                'expiresAt'
              ])

              && ownSettings.expiresAt is timestamp

              && ownSettings.expiresAt > request.time

              && ownSettings.expiresAt
                  <= request.time
                      + duration.value(25, 'h')
            )
          )
        )
      );
}
function isGroupMessageReactionUpdate(chatId) {
  let oldReactions =
      resource.data.get('reactions', {});

  let newReactions =
      request.resource.data.get('reactions', {});

  let newReaction =
      newReactions.get(request.auth.uid, '');

  return isChatMember(chatId)

      && chatDoc(chatId).data.type == 'group'

      && resource.data
          .get('deletedForEveryone', false) != true

      && request.resource.data
          .get('deletedForEveryone', false) != true

      && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'reactions'
          ])

      && oldReactions is map
      && newReactions is map

      && newReactions
          .diff(oldReactions)
          .affectedKeys()
          .hasOnly([
            request.auth.uid
          ])

      && (
        !newReactions.keys().hasAny([
          request.auth.uid
        ])

        || newReaction == 'like'
        || newReaction == 'dislike'
      );
}
function isHideMessageForCurrentUserUpdate(chatId, messageId) {
  let oldHiddenFor = resource.data.get('hiddenFor', {});
  let newHiddenFor = request.resource.data.get('hiddenFor', {});

  let chatBefore = chatDoc(chatId).data;
  let chatAfter = getAfter(
    /databases/$(database)/documents/chats/$(chatId)
  ).data;

  let lastMessageHiddenFor =
      chatAfter.get('lastMessageHiddenFor', {});

  return isChatMember(chatId)
      && resource.data.get('deletedForEveryone', false) != true

      && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['hiddenFor'])

      && oldHiddenFor is map
      && newHiddenFor is map

      && newHiddenFor.keys().hasAll([
        request.auth.uid
      ])

      && newHiddenFor
          .diff(oldHiddenFor)
          .affectedKeys()
          .hasOnly([request.auth.uid])

      && newHiddenFor[request.auth.uid] is timestamp
      && newHiddenFor[request.auth.uid] == request.time

      && (
        chatBefore.get('lastMessageId', '') != messageId
        || (
          lastMessageHiddenFor is map
          && lastMessageHiddenFor[request.auth.uid] == messageId
        )
      );
}

function isHideLastMessageForCurrentUserUpdate(chatId) {
  let oldHiddenFor =
      resource.data.get('lastMessageHiddenFor', {});

  let newHiddenFor =
      request.resource.data.get('lastMessageHiddenFor', {});

  let messageId = resource.data.get('lastMessageId', '');

  let messageAfter = getAfter(
    /databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)
  ).data;

  let messageHiddenFor =
      messageAfter.get('hiddenFor', {});

  return isCurrentMemberInChat()
      && messageId is string
      && messageId.size() > 0

      && changedKeys().hasOnly([
        'lastMessageHiddenFor'
      ])

      && oldHiddenFor is map
      && newHiddenFor is map

      && newHiddenFor.keys().hasAll([
        request.auth.uid
      ])

      && newHiddenFor
          .diff(oldHiddenFor)
          .affectedKeys()
          .hasOnly([request.auth.uid])

      && newHiddenFor[request.auth.uid] == messageId

      && messageHiddenFor is map
      && messageHiddenFor[request.auth.uid] is timestamp
      && messageHiddenFor[request.auth.uid] == request.time;
}

function isDeleteMessageForEveryoneUpdate(chatId, messageId) {
  let chatBefore = chatDoc(chatId).data;
  let chatAfter = getAfter(
    /databases/$(database)/documents/chats/$(chatId)
  ).data;

  return isChatMember(chatId)
      && resource.data.senderId == request.auth.uid
      && resource.data.get('deletedForEveryone', false) != true

      && request.resource.data
          .diff(resource.data)
          .affectedKeys()
                    .hasAll([
            'deletedForEveryone',
            'deletedBy',
            'deletedAt'
          ])

      && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'text',
            'deletedForEveryone',
            'deletedBy',
            'deletedAt'
          ])

      && request.resource.data.text == ''
      && request.resource.data.deletedForEveryone == true
      && request.resource.data.deletedBy == request.auth.uid
      && request.resource.data.deletedAt is timestamp
      && request.resource.data.deletedAt == request.time

      && (
        chatBefore.get('lastMessageId', '') != messageId
        || (
          chatAfter.lastMessage == ''
          && chatAfter.lastMessageDeletedForEveryoneId == messageId
        )
      );
}

function isDeleteLastMessageForEveryoneUpdate(chatId) {
  let messageId = resource.data.get('lastMessageId', '');

  let messagePath =
      /databases/$(database)/documents/chats/$(chatId)/messages/$(messageId);

  let messageBefore = get(messagePath).data;
  let messageAfter = getAfter(messagePath).data;

  return isCurrentMemberInChat()
      && messageId is string
      && messageId.size() > 0

      && changedKeys().hasAll([
        'lastMessage',
        'lastMessageDeletedForEveryoneId'
      ])

      && changedKeys().hasOnly([
        'lastMessage',
        'lastMessageDeletedForEveryoneId'
      ])

      && request.resource.data.lastMessage == ''
      && request.resource.data.lastMessageDeletedForEveryoneId == messageId

      && messageBefore.get('deletedForEveryone', false) != true

      && messageAfter.text == ''
      && messageAfter.senderId == request.auth.uid
      && messageAfter.deletedForEveryone == true
      && messageAfter.deletedBy == request.auth.uid
      && messageAfter.deletedAt is timestamp;
}

    function isAtomicLastMessageUpdate(chatId) {
      let messageId = request.resource.data.lastMessageId;
      let messagePath =
          /databases/$(database)/documents/chats/$(chatId)/messages/$(messageId);
      let messageAfter = getAfter(messagePath).data;

      return changedKeys().hasOnly([
            'lastMessage',
            'lastMessageAt',
            'lastMessageId'
          ])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage
              == request.resource.data.lastMessage.trim()
          && request.resource.data.lastMessage.size() > 0
          && request.resource.data.lastMessage.size() <= 4096
          && request.resource.data.lastMessageAt is timestamp
          && request.resource.data.lastMessageAt == request.time
          && messageId is string
          && messageId.size() > 0
          && !exists(messagePath)
          && existsAfter(messagePath)
          && messageAfter.senderId == request.auth.uid
                    && messagePreview(messageAfter)
              == request.resource.data.lastMessage
          && messageAfter.createdAt == request.resource.data.lastMessageAt;
    }

    function changesLastMessageMetadata() {
      return changedKeys().hasAny([
        'lastMessage',
        'lastMessageAt',
        'lastMessageId'
      ]);
    }

    function isAdminRightsTransferLastMessageUpdate() {
      return isCurrentAdminOrOwner()
          && changedKeys().hasAll([
            'memberRoles',
            'lastMessage',
            'lastMessageAt'
          ])
          && changedKeys().hasOnly([
            'memberRoles',
            'lastMessage',
            'lastMessageAt',
            'lastMessageId'
          ])
          && request.resource.data.memberRoles is map
          && request.resource.data.lastMessage
              == 'Права администратора переданы'
          && request.resource.data.lastMessageAt is timestamp
          && request.resource.data.lastMessageAt == request.time
          && !request.resource.data.keys().hasAny(['lastMessageId']);
    }

    function isDissolveGroupLastMessageUpdate() {
      return isCurrentAdminOrOwner()
          && resource.data.type == 'group'
          && changedKeys().hasAll([
            'isDissolved',
            'dissolvedBy',
            'dissolvedAt',
            'lastMessage',
            'lastMessageAt',
            'memberIds',
            'memberEmails'
          ])
          && changedKeys().hasOnly([
            'isDissolved',
            'dissolvedBy',
            'dissolvedAt',
            'lastMessage',
            'lastMessageAt',
            'lastMessageId',
            'memberIds',
            'memberEmails'
          ])
          && request.resource.data.isDissolved == true
          && request.resource.data.dissolvedBy == request.auth.uid
          && request.resource.data.dissolvedAt is timestamp
          && request.resource.data.dissolvedAt == request.time
          && request.resource.data.lastMessage == 'Группа распущена'
          && request.resource.data.lastMessageAt is timestamp
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == 0
          && request.resource.data.memberEmails is list
          && request.resource.data.memberEmails.size() == 0
          && !request.resource.data.keys().hasAny(['lastMessageId']);
    }

    function isAddMembersUpdate() {
      return changedKeys().hasOnly([
        'memberIds',
        'memberEmails',
        'memberRoles',
        'memberStatus'
      ]);
    }

    function getMessagePermissionFromResource() {
      return resource.data.groupSettings.messagePermission;
    }

    function currentStatusInChat() {
      return resource.data.memberStatus[request.auth.uid].status;
    }

    function canAddMembersByPermission() {
      return isCurrentMemberInChat()
          && currentRoleInChat() != 'guest'
          && currentStatusInChat() != 'muted'
          && currentStatusInChat() != 'banned'
          && (
            (
              getMessagePermissionFromResource() == 'all'
              && (
                currentRoleInChat() == 'member'
                || currentRoleInChat() == 'moderator'
                || currentRoleInChat() == 'admin'
                || currentRoleInChat() == 'owner'
              )
            )
            ||
            (
              getMessagePermissionFromResource() == 'moderators'
              && isCurrentModeratorOrAbove()
            )
            ||
            (
              getMessagePermissionFromResource() == 'admins'
              && isCurrentAdminOrOwner()
            )
          );
    }

    function isOnlyMemberStatusUpdate() {
      return changedKeys().hasOnly(['memberStatus']);
    }

    function requestedMemberStatusValues() {
      return request.resource.data.memberStatus.values();
    }

    function isOnlyMuteOrNormalStatusUpdate() {
      return requestedMemberStatusValues().hasOnly([
        {'status': 'normal'},
        {'status': 'muted'}
      ]);
    }

    function canUpdateMemberStatus() {
      return isCurrentMemberInChat()
          && (
            isCurrentAdminOrOwner()
            ||
            (
              isCurrentModeratorOrAbove()
              && isOnlyMuteOrNormalStatusUpdate()
            )
          );
    }

    function isLeaveGroupUpdate() {
      return isCurrentMemberInChat()
          && changedKeys().hasOnly([
            'memberIds',
            'memberEmails',
            'memberRoles',
            'memberStatus',
            'lastRead'
          ])
          && !(request.auth.uid in request.resource.data.memberIds)
          && !(request.auth.uid in request.resource.data.memberRoles.keys())
          && !(request.auth.uid in request.resource.data.memberStatus.keys())
          && !(request.auth.uid in request.resource.data.lastRead.keys());
    }

    function isPrivateChatSelfRepair() {
  let oldLastRead =
      resource.data.get('lastRead', {});

  let newLastRead =
      request.resource.data.get('lastRead', {});

  let affectedKeys =
      request.resource.data
          .diff(resource.data)
          .affectedKeys();

  return signedIn()
      && resource.data.type == 'private'

      && request.auth.uid
          in resource.data.memberIds

      && request.auth.uid
          in request.resource.data.memberIds

      && request.resource.data.type == 'private'

      && request.resource.data.memberIds
          == resource.data.memberIds

      && affectedKeys.hasOnly([
        'name',
        'type',
        'memberIds',
        'memberEmails',
        'memberRoles',
        'memberStatus',
        'groupSettings',
        'lastRead',
        'isDissolved'
      ])

      && (
        !affectedKeys.hasAny([
          'lastRead'
        ])

        || (
          oldLastRead is map
          && newLastRead is map

          && newLastRead.keys().hasAll([
            request.auth.uid
          ])

          && newLastRead
              .diff(oldLastRead)
              .affectedKeys()
              .hasOnly([
                request.auth.uid
              ])

          && newLastRead[request.auth.uid]
              is timestamp

          && newLastRead[request.auth.uid]
              == request.time
        )
      );
}

    function isPrivateChatIdParticipant(chatId) {
      return chatId.matches('.*' + request.auth.uid + '.*');
    }
    function isSpacesOwner() {
  return signedIn()
      && exists(
        /databases/$(database)/documents/spaces_access/$(request.auth.uid)
      )
      && get(
        /databases/$(database)/documents/spaces_access/$(request.auth.uid)
      ).data.get('role', '') == 'owner';
}

function isValidBrigadierAccessCreate(userId) {
  return request.resource.data.keys().hasOnly([
        'role'
      ])
      && request.resource.data.role == 'brigadier'
      && userId != request.auth.uid
      && exists(
        /databases/$(database)/documents/users/$(userId)
      );
}

match /spaces_access/{userId} {
  allow get: if signedIn()
      && (
        request.auth.uid == userId
        || isSpacesOwner()
      );

  allow list: if isSpacesOwner();

  allow create: if isSpacesOwner()
      && isValidBrigadierAccessCreate(userId);

  // Role mutation is intentionally not supported.
  // member = no document.
  // brigadier is revoked by deleting the document.
  // owner is created/changed only through trusted administration.
  allow update: if false;

  allow delete: if isSpacesOwner()
      && resource.data.keys().hasOnly([
        'role'
      ])
      && resource.data.role == 'brigadier';
}
function isSpacesManager() {
  return signedIn()
      && exists(
        /databases/$(database)/documents/spaces_access/$(request.auth.uid)
      )
      && (
        get(
          /databases/$(database)/documents/spaces_access/$(request.auth.uid)
        ).data.get('role', '') == 'owner'
        ||
        get(
          /databases/$(database)/documents/spaces_access/$(request.auth.uid)
        ).data.get('role', '') == 'brigadier'
      );
}

function isManagedSubstitutionWorkDisplayNameUpdate(userId) {
  return isSpacesManager()

      && exists(
        /databases/$(database)/documents/spaces/substitution/participants/$(userId)
      )

      && changedKeys().hasAny([
        'workDisplayName'
      ])

      && changedKeys().hasOnly([
        'workDisplayName'
      ])

      && request.resource.data.keys().hasAny([
        'workDisplayName'
      ])

      && request.resource.data.workDisplayName is string

      && request.resource.data.workDisplayName.size() <= 80;
}

function hasValidSubstitutionParticipantData(data) {
  return data.keys().hasAll([
        'rotationOrder',
        'availability',
        'status'
      ])
      && data.keys().hasOnly([
        'rotationOrder',
        'availability',
        'status'
      ])

      && data.rotationOrder is int
      && data.rotationOrder >= 0

      && (
        data.availability == 'green'
        || data.availability == 'yellow'
        || data.availability == 'red'
      )

      && (
        data.status == 'active'
        || data.status == 'vacation'
        || data.status == 'sick'
      );
}

function isValidNewSubstitutionParticipant() {
  return hasValidSubstitutionParticipantData(
        request.resource.data
      )
      && request.resource.data.availability == 'green'
      && request.resource.data.status == 'active';
}

function isOwnSubstitutionParticipantStateUpdate(userId) {
  return signedIn()
      && request.auth.uid == userId

      && hasValidSubstitutionParticipantData(
        request.resource.data
      )

      && request.resource.data.rotationOrder
          == resource.data.rotationOrder

      && changedKeys().hasAny([
        'availability',
        'status'
      ])

      && changedKeys().hasOnly([
        'availability',
        'status'
      ]);
}

function isManagedSubstitutionParticipantStatusUpdate() {
  return isSpacesManager()

      && hasValidSubstitutionParticipantData(
        request.resource.data
      )

      && request.resource.data.rotationOrder
          == resource.data.rotationOrder

      && changedKeys().hasAny([
        'status'
      ])

      && changedKeys().hasOnly([
        'status'
      ]);
}

function hasValidInitialSubstitutionModule() {
  return request.resource.data.keys().hasAll([
        'nextRotationOrder'
      ])
      && request.resource.data.keys().hasOnly([
        'nextRotationOrder'
      ])
      && request.resource.data.nextRotationOrder is int
      && request.resource.data.nextRotationOrder > 0;
}

function isSubstitutionNextOrderUpdate() {
  return isSpacesManager()

      && changedKeys().hasOnly([
        'nextRotationOrder'
      ])

      && request.resource.data.nextRotationOrder is int
      && resource.data.nextRotationOrder is int

      && request.resource.data.nextRotationOrder
          > resource.data.nextRotationOrder;
}
function hasValidSubstitutionPendingCallData(data, callId) {
  return data.keys().hasAll([
        'callId',
        'userId',
        'revision',
        'calledByUserId',
        'calledAt',
        'shiftYear',
        'shiftMonth',
        'shiftDay',
        'shiftKind'
      ])

      && data.keys().hasOnly([
        'callId',
        'userId',
        'revision',
        'calledByUserId',
        'calledAt',
        'shiftYear',
        'shiftMonth',
        'shiftDay',
        'shiftKind'
      ])

      && data.callId is string
      && data.callId == callId
      && data.callId.size() > 0

      && data.userId is string
      && data.userId.size() > 0
      && !data.userId.matches('.*[/].*')

      && data.revision is int
      && data.revision > 0
      && data.callId == string(data.revision)

      && data.calledByUserId is string
      && data.calledByUserId.size() > 0
      && !data.calledByUserId.matches('.*[/].*')

      && data.calledAt is timestamp

      && data.shiftYear is int
      && data.shiftYear > 0

      && data.shiftMonth is int
      && data.shiftMonth >= 1
      && data.shiftMonth <= 12

      && data.shiftDay is int
      && data.shiftDay >= 1
      && data.shiftDay <= 31

      && data.shiftKind is string
      && data.shiftKind in [
        'day',
        'night'
      ];
}

function isSubstitutionCallModuleUpdate() {
  let moduleBefore = resource.data;
  let moduleAfter = request.resource.data;

  let lastCall = moduleAfter.get('lastCall', {});
  let calledUserId = lastCall.get('userId', '');

  let participantPath =
      /databases/$(database)/documents/spaces/substitution/participants/$(calledUserId);

  let participantBefore = get(participantPath).data;
  let participantAfter = getAfter(participantPath).data;

  let previousRevision =
      moduleBefore.get('revision', 0);

        let callId =
      string(moduleAfter.get('revision', 0));

  let pendingPath =
      /databases/$(database)/documents/spaces/substitution/pendingCalls/$(callId);

  return isSpacesManager()

      && changedKeys().hasAll([
        'nextRotationOrder',
        'revision',
        'lastCall'
      ])

      && changedKeys().hasOnly([
        'nextRotationOrder',
        'revision',
        'lastCall'
      ])

      && moduleAfter.keys().hasAll([
        'nextRotationOrder',
        'revision',
        'lastCall'
      ])

      && moduleAfter.keys().hasOnly([
        'nextRotationOrder',
        'revision',
        'lastCall'
      ])

      && moduleBefore.nextRotationOrder is int
      && moduleAfter.nextRotationOrder is int

      && moduleAfter.nextRotationOrder
          == moduleBefore.nextRotationOrder + 1

      && previousRevision is int
      && previousRevision >= 0

      && moduleAfter.revision is int
      && moduleAfter.revision == previousRevision + 1

      && lastCall is map

      && lastCall.keys().hasAll([
        'userId',
        'previousRotationOrder',
        'revision'
      ])

      && lastCall.keys().hasOnly([
        'userId',
        'previousRotationOrder',
        'revision'
      ])

      && calledUserId is string
      && calledUserId.size() > 0

      && lastCall.previousRotationOrder is int
      && lastCall.previousRotationOrder >= 0

      && lastCall.revision is int
      && lastCall.revision == moduleAfter.revision

      && exists(participantPath)

      && hasValidSubstitutionParticipantData(
        participantBefore
      )

      && hasValidSubstitutionParticipantData(
        participantAfter
      )

      && participantBefore.status == 'active'

      && participantAfter.status
          == participantBefore.status

      && participantAfter.availability
          == participantBefore.availability

      && participantAfter.rotationOrder
          == moduleBefore.nextRotationOrder

      && participantAfter.rotationOrder
          != participantBefore.rotationOrder

            && lastCall.previousRotationOrder
          == participantBefore.rotationOrder

      && !exists(pendingPath)
      && existsAfter(pendingPath)

      && hasValidSubstitutionPendingCallData(
        getAfter(pendingPath).data,
        callId
      )

      && getAfter(pendingPath).data.userId
          == calledUserId

      && getAfter(pendingPath).data.revision
          == moduleAfter.revision

      && getAfter(pendingPath).data.calledByUserId
          == request.auth.uid

      && getAfter(pendingPath).data.calledAt
          == request.time;
}

function isSubstitutionUndoModuleUpdate() {
  let moduleBefore = resource.data;
  let moduleAfter = request.resource.data;

  let lastCall = moduleBefore.get('lastCall', {});
  let calledUserId = lastCall.get('userId', '');

  let participantPath =
      /databases/$(database)/documents/spaces/substitution/participants/$(calledUserId);

  let participantBefore = get(participantPath).data;
  let participantAfter = getAfter(participantPath).data;
    let callId =
      string(moduleBefore.get('revision', 0));

  let pendingPath =
      /databases/$(database)/documents/spaces/substitution/pendingCalls/$(callId);

  return isSpacesManager()

      && changedKeys().hasOnly([
        'lastCall'
      ])

      && moduleBefore.keys().hasAll([
        'nextRotationOrder',
        'revision',
        'lastCall'
      ])

      && moduleBefore.keys().hasOnly([
        'nextRotationOrder',
        'revision',
        'lastCall'
      ])

      && moduleAfter.keys().hasAll([
        'nextRotationOrder',
        'revision'
      ])

      && moduleAfter.keys().hasOnly([
        'nextRotationOrder',
        'revision'
      ])

      && !moduleAfter.keys().hasAny([
        'lastCall'
      ])

      && moduleAfter.nextRotationOrder
          == moduleBefore.nextRotationOrder

      && moduleAfter.revision
          == moduleBefore.revision

      && moduleBefore.nextRotationOrder is int
      && moduleBefore.revision is int

      && lastCall is map

      && lastCall.keys().hasAll([
        'userId',
        'previousRotationOrder',
        'revision'
      ])

      && lastCall.keys().hasOnly([
        'userId',
        'previousRotationOrder',
        'revision'
      ])

      && calledUserId is string
      && calledUserId.size() > 0

      && lastCall.previousRotationOrder is int
      && lastCall.previousRotationOrder >= 0

      && lastCall.revision is int
      && lastCall.revision == moduleBefore.revision

      && exists(participantPath)

      && hasValidSubstitutionParticipantData(
        participantBefore
      )

      && hasValidSubstitutionParticipantData(
        participantAfter
      )

      && participantAfter.status
          == participantBefore.status

      && participantAfter.availability
          == participantBefore.availability

      && participantAfter.rotationOrder
          == lastCall.previousRotationOrder

            && participantAfter.rotationOrder
          != participantBefore.rotationOrder

      && exists(pendingPath)
      && !existsAfter(pendingPath)

      && hasValidSubstitutionPendingCallData(
        get(pendingPath).data,
        callId
      )

      && get(pendingPath).data.userId
          == calledUserId

      && get(pendingPath).data.revision
          == moduleBefore.revision

      && get(pendingPath).data.calledAt
          <= request.time

      && request.time
          < get(pendingPath).data.calledAt
              + duration.value(6, 's');
}

function isManagedSubstitutionCallParticipantUpdate(userId) {
  let modulePath =
      /databases/$(database)/documents/spaces/substitution;

  let moduleBefore = get(modulePath).data;
  let moduleAfter = getAfter(modulePath).data;

  let lastCall = moduleAfter.get('lastCall', {});
  let previousRevision =
      moduleBefore.get('revision', 0);

  return isSpacesManager()

      && hasValidSubstitutionParticipantData(
        request.resource.data
      )

      && changedKeys().hasOnly([
        'rotationOrder'
      ])

      && request.resource.data.availability
          == resource.data.availability

      && request.resource.data.status
          == resource.data.status

      && resource.data.status == 'active'

      && request.resource.data.rotationOrder
          != resource.data.rotationOrder

      && moduleAfter.nextRotationOrder
          == moduleBefore.nextRotationOrder + 1

      && moduleAfter.revision
          == previousRevision + 1

      && lastCall is map

      && lastCall.get('userId', '') == userId

      && lastCall.get('previousRotationOrder', -1)
          == resource.data.rotationOrder

      && lastCall.get('revision', -1)
          == moduleAfter.revision

      && request.resource.data.rotationOrder
          == moduleBefore.nextRotationOrder;
}

function isManagedSubstitutionUndoParticipantUpdate(userId) {
  let modulePath =
      /databases/$(database)/documents/spaces/substitution;

  let moduleBefore = get(modulePath).data;
  let moduleAfter = getAfter(modulePath).data;

  let lastCall = moduleBefore.get('lastCall', {});

  return isSpacesManager()

      && hasValidSubstitutionParticipantData(
        request.resource.data
      )

      && changedKeys().hasOnly([
        'rotationOrder'
      ])

      && request.resource.data.availability
          == resource.data.availability

      && request.resource.data.status
          == resource.data.status

      && request.resource.data.rotationOrder
          != resource.data.rotationOrder

      && lastCall is map

      && lastCall.get('userId', '') == userId

      && lastCall.get('revision', -1)
          == moduleBefore.get('revision', -2)

      && request.resource.data.rotationOrder
          == lastCall.get('previousRotationOrder', -1)

      && moduleAfter.nextRotationOrder
          == moduleBefore.nextRotationOrder

      && moduleAfter.revision
          == moduleBefore.revision

      && !moduleAfter.keys().hasAny([
        'lastCall'
      ]);
}

match /spaces/substitution {
  allow get: if isSpacesManager();
  allow list: if false;

  allow create: if isSpacesManager()
      && hasValidInitialSubstitutionModule();

    allow update: if
      changedKeys().hasOnly([
        'nextRotationOrder'
      ])
      ? isSubstitutionNextOrderUpdate()
      : changedKeys().hasAny([
          'revision'
        ])
        ? isSubstitutionCallModuleUpdate()
        : changedKeys().hasOnly([
            'lastCall'
          ])
          ? isSubstitutionUndoModuleUpdate()
          : false;

  allow delete: if false;
      match /pendingCalls/{callId} {
    allow get: if isSpacesManager();
    allow list: if false;

    allow create: if
        isSpacesManager()

        && hasValidSubstitutionPendingCallData(
          request.resource.data,
          callId
        )

        && request.resource.data.calledByUserId
            == request.auth.uid

        && request.resource.data.calledAt
            == request.time

        && getAfter(
          /databases/$(database)/documents/spaces/substitution
        ).data.revision
            == request.resource.data.revision

        && getAfter(
          /databases/$(database)/documents/spaces/substitution
        ).data.nextRotationOrder
            == get(
              /databases/$(database)/documents/spaces/substitution
            ).data.nextRotationOrder + 1

        && getAfter(
          /databases/$(database)/documents/spaces/substitution
        ).data.lastCall.userId
            == request.resource.data.userId

        && getAfter(
          /databases/$(database)/documents/spaces/substitution
        ).data.lastCall.revision
            == request.resource.data.revision

        && getAfter(
          /databases/$(database)/documents/spaces/substitution
        ).data.lastCall.previousRotationOrder
            == get(
              /databases/$(database)/documents/spaces/substitution/participants/$(request.resource.data.userId)
            ).data.rotationOrder

        && getAfter(
          /databases/$(database)/documents/spaces/substitution/participants/$(request.resource.data.userId)
        ).data.rotationOrder
            == get(
              /databases/$(database)/documents/spaces/substitution
            ).data.nextRotationOrder

        && getAfter(
          /databases/$(database)/documents/spaces/substitution/participants/$(request.resource.data.userId)
        ).data.rotationOrder
            != get(
              /databases/$(database)/documents/spaces/substitution/participants/$(request.resource.data.userId)
            ).data.rotationOrder;

    allow update: if false;

    allow delete: if
        isSpacesManager()

        && hasValidSubstitutionPendingCallData(
          resource.data,
          callId
        )

        && resource.data.calledAt <= request.time

        && request.time
            < resource.data.calledAt
                + duration.value(6, 's')

        && get(
          /databases/$(database)/documents/spaces/substitution
        ).data.revision
            == resource.data.revision

        && get(
          /databases/$(database)/documents/spaces/substitution
        ).data.lastCall.userId
            == resource.data.userId

        && get(
          /databases/$(database)/documents/spaces/substitution
        ).data.lastCall.revision
            == resource.data.revision

        && getAfter(
          /databases/$(database)/documents/spaces/substitution
        ).data.revision
            == get(
              /databases/$(database)/documents/spaces/substitution
            ).data.revision

        && getAfter(
          /databases/$(database)/documents/spaces/substitution
        ).data.nextRotationOrder
            == get(
              /databases/$(database)/documents/spaces/substitution
            ).data.nextRotationOrder

        && !getAfter(
          /databases/$(database)/documents/spaces/substitution
        ).data.keys().hasAny([
          'lastCall'
        ])

        && getAfter(
          /databases/$(database)/documents/spaces/substitution/participants/$(resource.data.userId)
        ).data.rotationOrder
            == get(
              /databases/$(database)/documents/spaces/substitution
            ).data.lastCall.previousRotationOrder

        && getAfter(
          /databases/$(database)/documents/spaces/substitution/participants/$(resource.data.userId)
        ).data.rotationOrder
            != get(
              /databases/$(database)/documents/spaces/substitution/participants/$(resource.data.userId)
            ).data.rotationOrder;
  }

    match /statistics/test {
    allow get: if signedIn();
    allow list: if false;

    // TEST statistics are read-only at this stage.
    // Finalize/write rules will be added separately.
    allow create, update, delete: if false;
  }

  match /participants/{userId} {
    allow get, list: if signedIn();

    allow create: if isSpacesManager()
        && isValidNewSubstitutionParticipant();

        allow update: if
        changedKeys().hasOnly([
          'rotationOrder'
        ])
        ? (
          isManagedSubstitutionCallParticipantUpdate(userId)
          || isManagedSubstitutionUndoParticipantUpdate(userId)
        )
        : (
          isOwnSubstitutionParticipantStateUpdate(userId)
          || isManagedSubstitutionParticipantStatusUpdate()
        );

    allow delete: if isSpacesManager();
  }
}

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.auth.uid == userId
          && hasValidAvatarMetadataOnCreate(userId);

      allow update: if signedIn()
    && (
      (
        request.auth.uid == userId
        && hasValidUserUpdate(userId)
      )
      ||
      isManagedSubstitutionWorkDisplayNameUpdate(userId)
    );

      allow delete: if false;
      match /devices/{deviceId} {
  allow get, list: if signedIn()
      && request.auth.uid == userId;

  allow create, update: if signedIn()
      && request.auth.uid == userId
      && request.resource.data.keys().hasAll([
        'token',
        'platform',
        'updatedAt'
      ])
      && request.resource.data.keys().hasOnly([
        'token',
        'platform',
        'updatedAt'
      ])
      && request.resource.data.token is string
      && request.resource.data.token.size() > 0
      && request.resource.data.token.size() <= 4096
      && request.resource.data.platform is string
      && request.resource.data.updatedAt is timestamp
      && request.resource.data.updatedAt == request.time;

  allow delete: if signedIn()
      && request.auth.uid == userId;
}
    }

        match /chats/{chatId} {
      allow get: if signedIn()
          && (
            isPrivateChatIdParticipant(chatId)
            || request.auth.uid in resource.data.memberIds
          );

      allow list: if signedIn()
          && request.auth.uid in resource.data.memberIds;

      allow create: if isValidChatCreate(chatId);

      allow update: if
  changedKeys().hasOnly([
    'lastMessage',
    'lastMessageAt',
    'lastMessageId'
  ])
  ? (
    canWrite(chatId)
    && isAtomicLastMessageUpdate(chatId)
  )
  : changedKeys().hasOnly([
      'lastRead'
    ])
    ? isOwnLastReadUpdate()
    : (
        changedKeys().hasOnly([
          'lastRead',
          'privateReadState'
        ])
        && changedKeys().hasAny([
          'privateReadState'
        ])
      )
      ? isPrivateReadReceiptUpdate(chatId)
      : (
        (
          isCurrentAdminOrOwner()
          && !changesLastMessageMetadata()
          && !changedKeys().hasAny(
            groupAvatarControlledKeys()
          )
          && !changedKeys().hasAny([
  'lastRead',
  'privateReadState',
  'notificationSettingsByUser'
])
        )
        || isGroupAvatarMetadataUpdate(chatId)
        || isAdminRightsTransferLastMessageUpdate()
        || isDissolveGroupLastMessageUpdate()
        || (
          canAddMembersByPermission()
          && isAddMembersUpdate()
        )
        || (
          canUpdateMemberStatus()
          && isOnlyMemberStatusUpdate()
        )
        || isLeaveGroupUpdate()
        || isClearPrivateChatForCurrentUserUpdate()
|| isOwnNotificationSettingsUpdate()
|| isPrivateChatSelfRepair()
        || isHideLastMessageForCurrentUserUpdate(chatId)
        || isDeleteLastMessageForEveryoneUpdate(chatId)
      );

            allow delete: if false;

           match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if
          isValidNewMessage(chatId, messageId)
          && (
            isFirstMessageForNewPrivateChat(
              chatId,
              messageId
            )
            || (
              canWrite(chatId)
              && isMessageLinkedToExistingChatUpdate(
                chatId,
                messageId
              )
            )
          );

        allow update: if
  isGroupMessageReactionUpdate(chatId)
  || isHideMessageForCurrentUserUpdate(
    chatId,
    messageId
  )
  || isDeleteMessageForEveryoneUpdate(
    chatId,
    messageId
  );

        allow delete: if false;
      }
    }

    // Grants are issued only by trusted server code through Admin SDK.
    // Client applications must never access this collection directly.
    match /imageMessageUploadGrants/{grantId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
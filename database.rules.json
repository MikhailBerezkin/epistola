{
  "rules": {
    ".read": false,
    ".write": false,

    "privateChatAccess": {
      "$chatId": {
        ".read": false,
        ".write": false
      }
    },

    "privateTyping": {
      "$chatId": {
        "$userId": {
          ".read": "auth != null && root.child('privateChatAccess').child($chatId).child(auth.uid).val() === true",
          ".write": "auth != null && auth.uid === $userId && root.child('privateChatAccess').child($chatId).child(auth.uid).val() === true",
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 10000"
        }
      }
    }
  }
}
